{
  "name": "openchamber-design-canvas",
  "version": "0.2.0",
  "description": "OpenChamber Design Canvas — a project-free, multi-screen artboard canvas with live edit/play and point-and-edit into the standard OpenChamber chat.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "openchamber",
    "openchamber-extension",
    "design",
    "ui",
    "design-system",
    "live-preview",
    "ai-agent"
  ],
  "homepage": "https://github.com/lastonoga/openchamber-design-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lastonoga/openchamber-design-studio.git"
  },
  "bugs": {
    "url": "https://github.com/lastonoga/openchamber-design-studio/issues"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.2.0"
    },
    "contributes": {
      "panel": {
        "id": "design-canvas",
        "name": "Design Canvas",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "panel/index.html",
        "title": "Design Canvas"
      },
      "commands": [
        {
          "name": "canvas",
          "description": "Start or toggle the design canvas and attach design context"
        }
      ],
      "capabilities": [
        "prompt",
        "sessions"
      ],
      "statusSection": {
        "entry": "panel/index.html",
        "title": "Canvas",
        "requiresProject": false,
        "defaultExpanded": true,
        "height": 84
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "browser"
        ]
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "typecheck:viewer": "tsc --noEmit -p viewer-client/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@openchamber/sdk": "2.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "esbuild": "^0.24.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "@tailwindcss/oxide@4.3.3": true,
    "@parcel/watcher@2.5.1": true
  }
}
